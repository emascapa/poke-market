{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Sicurezza aggiuntiva per accessi a array e oggetti (può avere falsi positivi).
    "noUncheckedIndexedAccess": true,

    // Mapping dei percorsi per import più puliti.
    "paths": {
      "@/*": ["./src/*"]
    },

    // Il file .tsbuildinfo viene salvato qui per non inquinare la root.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
